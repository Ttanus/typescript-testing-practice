{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "CommonJS",       // works well with Mocha, Vitest, Node
    "target": "ES2020",         // modern JS output but still Node-compatible
    "moduleResolution": "node", // standard for Node apps
    "esModuleInterop": true,    // allows default imports from CommonJS
    "types": ["node"],          // includes Node.js types
    "lib": ["ES2020"],          // standard JS library

    // Type checking
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Source maps for debugging
    "sourceMap": true,
  },
  // Include code and tests
  "include": ["src", "tests"],
  "exclude": ["dist"]
}
